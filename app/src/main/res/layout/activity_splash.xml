<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_flo_gradient">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">
        <FrameLayout
            android:id="@+id/cardLogo"
            android:layout_width="240dp"
            android:layout_height="240dp">
            <com.example.hidratapp.WaterIllustrationView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <TextView
            android:id="@+id/tvTituloSplash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="hidratapp"
            android:textSize="46sp"
            android:letterSpacing="-0.04"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary" />
        <TextView
            android:id="@+id/tvSubtituloSplash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:text="Um gole de cada vez."
            android:textSize="17sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="32dp">
        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/blue_primary" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:text="SEU MOMENTO DE CUIDADO"
            android:textSize="10sp"
            android:letterSpacing="0.14"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</RelativeLayout>
