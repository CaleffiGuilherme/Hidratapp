<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@drawable/bg_wizard_gradient" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="24dp">
                <ImageButton android:id="@+id/btnHeaderVoltar" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/bg_white_round" android:src="@drawable/ic_arrow_back" app:tint="@color/blue_primary" android:contentDescription="Voltar" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="CONHEÇA O HIDRATAPP" android:layout_marginStart="14dp" android:textColor="@color/text_secondary" android:textSize="10sp" android:letterSpacing="0.12" android:fontFamily="sans-serif-medium" />
                <ImageView android:layout_width="38dp" android:layout_height="38dp" android:padding="8dp" android:background="@drawable/bg_soft_blue" android:src="@drawable/ic_info" app:tint="@color/blue_primary" android:importantForAccessibility="no" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Feito para o seu bem-estar." android:textSize="30sp" android:letterSpacing="-0.035" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Um jeito mais leve de acompanhar sua hidratação." android:textSize="14sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="3dp" android:layout_marginTop="10dp" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/white" app:strokeWidth="1dp" app:strokeColor="@color/line_soft">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
                <com.example.hidratapp.WaterIllustrationView android:layout_width="match_parent" android:layout_height="130dp" android:contentDescription="Hidratapp Logo" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Hidratapp" android:textColor="@color/teal_primary" android:textSize="26sp" android:textStyle="bold" android:lineSpacingExtra="2dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Versão 1.0 • Saúde e Bem-estar" android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="2dp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line_soft" android:layout_marginTop="20dp" android:layout_marginBottom="20dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aplicativo para registrar o seu consumo diário de líquidos e acompanhar a sua meta personalizada de hidratação." android:textColor="@color/text_primary" android:textSize="15sp" android:lineSpacingExtra="2dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Sua meta é calculada com base no seu peso, idade, sexo e frequência de esportes. O app também monitora o consumo de café e álcool e permite registrar sintomas e consultar informações educativas." android:textColor="@color/text_primary" android:textSize="15sp" android:lineSpacingExtra="2dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Nota: Os valores calculados são estimativas para acompanhamento de hábitos e não substituem consulta com profissionais de saúde." android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="italic" android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <Button android:id="@+id/btnSobreRegras" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Regras, limites e fontes" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnVoltar" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:text="Voltar ao Início" android:textColor="@color/blue_primary" android:textSize="15sp" app:cornerRadius="22dp" app:strokeColor="@color/line_soft" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>