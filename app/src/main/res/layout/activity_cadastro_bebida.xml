<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_flo_gradient">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">
                <ImageButton
                    android:id="@+id/btnHeaderVoltar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:background="@drawable/bg_white_round"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/blue_primary"
                    android:contentDescription="Voltar" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="MAIS UM GOLE NO SEU DIA"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:textColor="@color/text_secondary" />
                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_water_drop"
                    android:background="@drawable/bg_soft_blue"
                    app:tint="@color/blue_primary"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seu próximo gole."
                android:textSize="30sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="3dp"
                android:id="@+id/tvTituloCadastro"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.035" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Um pequeno registro. Mais cuidado com você."
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="O que você bebeu?"
                        android:textSize="17sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="12dp" />
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipTipos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="4dp">
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAgua"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Água"
                            android:textSize="13sp"
                            android:textColor="@color/drink_chip_text"
                            android:checkable="true"
                            android:checked="true"
                            app:chipBackgroundColor="@color/drink_chip_background"
                            app:chipStrokeColor="@color/drink_chip_stroke"
                            app:chipStrokeWidth="1dp"
                            app:chipCornerRadius="16dp"
                            app:chipIcon="@drawable/ic_water_drop"
                            app:chipIconVisible="true"
                            app:chipIconTint="@color/blue_primary"
                            app:checkedIconVisible="false"
                            app:ensureMinTouchTargetSize="true" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSuco"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Suco"
                            android:textSize="13sp"
                            android:textColor="@color/drink_chip_text"
                            android:checkable="true"
                            android:checked="false"
                            app:chipBackgroundColor="@color/drink_chip_background"
                            app:chipStrokeColor="@color/drink_chip_stroke"
                            app:chipStrokeWidth="1dp"
                            app:chipCornerRadius="16dp"
                            app:chipIcon="@drawable/ic_drink_glass"
                            app:chipIconVisible="true"
                            app:chipIconTint="@color/blue_primary"
                            app:checkedIconVisible="false"
                            app:ensureMinTouchTargetSize="true" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipRefrigerante"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Refrigerante"
                            android:textSize="13sp"
                            android:textColor="@color/drink_chip_text"
                            android:checkable="true"
                            android:checked="false"
                            app:chipBackgroundColor="@color/drink_chip_background"
                            app:chipStrokeColor="@color/drink_chip_stroke"
                            app:chipStrokeWidth="1dp"
                            app:chipCornerRadius="16dp"
                            app:chipIcon="@drawable/ic_drink_glass"
                            app:chipIconVisible="true"
                            app:chipIconTint="@color/blue_primary"
                            app:checkedIconVisible="false"
                            app:ensureMinTouchTargetSize="true" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCafe"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Café"
                            android:textSize="13sp"
                            android:textColor="@color/drink_chip_text"
                            android:checkable="true"
                            android:checked="false"
                            app:chipBackgroundColor="@color/drink_chip_background"
                            app:chipStrokeColor="@color/drink_chip_stroke"
                            app:chipStrokeWidth="1dp"
                            app:chipCornerRadius="16dp"
                            app:chipIcon="@drawable/ic_coffee"
                            app:chipIconVisible="true"
                            app:chipIconTint="@color/blue_primary"
                            app:checkedIconVisible="false"
                            app:ensureMinTouchTargetSize="true" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipEnergetico"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Energético"
                            android:textSize="13sp"
                            android:textColor="@color/drink_chip_text"
                            android:checkable="true"
                            android:checked="false"
                            app:chipBackgroundColor="@color/drink_chip_background"
                            app:chipStrokeColor="@color/drink_chip_stroke"
                            app:chipStrokeWidth="1dp"
                            app:chipCornerRadius="16dp"
                            app:chipIcon="@drawable/ic_drink_glass"
                            app:chipIconVisible="true"
                            app:chipIconTint="@color/blue_primary"
                            app:checkedIconVisible="false"
                            app:ensureMinTouchTargetSize="true" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCerveja"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cerveja"
                            android:textSize="13sp"
                            android:textColor="@color/drink_chip_text"
                            android:checkable="true"
                            android:checked="false"
                            app:chipBackgroundColor="@color/drink_chip_background"
                            app:chipStrokeColor="@color/drink_chip_stroke"
                            app:chipStrokeWidth="1dp"
                            app:chipCornerRadius="16dp"
                            app:chipIcon="@drawable/ic_drink_glass"
                            app:chipIconVisible="true"
                            app:chipIconTint="@color/blue_primary"
                            app:checkedIconVisible="false"
                            app:ensureMinTouchTargetSize="true" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipVinho"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vinho"
                            android:textSize="13sp"
                            android:textColor="@color/drink_chip_text"
                            android:checkable="true"
                            android:checked="false"
                            app:chipBackgroundColor="@color/drink_chip_background"
                            app:chipStrokeColor="@color/drink_chip_stroke"
                            app:chipStrokeWidth="1dp"
                            app:chipCornerRadius="16dp"
                            app:chipIcon="@drawable/ic_drink_glass"
                            app:chipIconVisible="true"
                            app:chipIconTint="@color/blue_primary"
                            app:checkedIconVisible="false"
                            app:ensureMinTouchTargetSize="true" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDestilado"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Destilado"
                            android:textSize="13sp"
                            android:textColor="@color/drink_chip_text"
                            android:checkable="true"
                            android:checked="false"
                            app:chipBackgroundColor="@color/drink_chip_background"
                            app:chipStrokeColor="@color/drink_chip_stroke"
                            app:chipStrokeWidth="1dp"
                            app:chipCornerRadius="16dp"
                            app:chipIcon="@drawable/ic_drink_glass"
                            app:chipIconVisible="true"
                            app:chipIconTint="@color/blue_primary"
                            app:checkedIconVisible="false"
                            app:ensureMinTouchTargetSize="true" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quanto você bebeu?"
                        android:textSize="17sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="12dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="88dp"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <EditText
                            android:id="@+id/etMl"
                            android:layout_width="160dp"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:padding="0dp"
                            android:inputType="number"
                            android:maxLength="4"
                            android:hint="0"
                            android:textSize="48sp"
                            android:letterSpacing="-0.04"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/blue_pastel"
                            android:selectAllOnFocus="true"
                            android:imeOptions="actionDone"
                            android:contentDescription="Quantidade da bebida em mililitros" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ml"
                            android:textSize="20sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Toque no número ou use um atalho para somar."
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="3dp"
                        android:gravity="center"
                        android:layout_marginBottom="12dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn200"
                            style="@style/HomeQuick"
                            android:layout_height="52dp"
                            android:text="+200 ml"
                            android:textSize="12sp"
                            app:backgroundTint="@color/blue_light"
                            app:strokeWidth="0dp"
                            app:cornerRadius="16dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn300"
                            style="@style/HomeQuick"
                            android:layout_height="52dp"
                            android:text="+300 ml"
                            android:textSize="12sp"
                            app:backgroundTint="@color/blue_light"
                            app:strokeWidth="0dp"
                            app:cornerRadius="16dp" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn500"
                            style="@style/HomeQuick"
                            android:layout_height="52dp"
                            android:text="+500 ml"
                            android:textSize="12sp"
                            app:backgroundTint="@color/blue_light"
                            app:strokeWidth="0dp"
                            app:cornerRadius="16dp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Água · escolha a quantidade"
                        android:textSize="12sp"
                        android:textColor="@color/blue_primary"
                        android:lineSpacingExtra="3dp"
                        android:id="@+id/tvResumoRegistro"
                        android:gravity="center"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quando foi esse gole?"
                        android:textSize="17sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="12dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilData"
                            style="@style/Widget.Material3.TextInputLayout.FilledBox"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Data"
                            app:boxBackgroundColor="@color/blue_light"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="1dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            android:layout_marginEnd="6dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etData"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="60dp"
                                android:clickable="true"
                                android:focusable="false"
                                android:inputType="none"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilHoraConsumo"
                            style="@style/Widget.Material3.TextInputLayout.FilledBox"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="Horário"
                            app:boxBackgroundColor="@color/blue_light"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="1dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusBottomEnd="16dp"
                            android:layout_marginStart="6dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etHoraConsumo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="60dp"
                                android:clickable="true"
                                android:focusable="false"
                                android:inputType="none"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Algo para lembrar?"
                        android:textSize="17sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="12dp" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilObservacao"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Uma observação, se quiser"
                        app:boxBackgroundColor="@color/blue_light"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="1dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etObservacao"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences|textMultiLine"
                            android:minLines="2"
                            android:maxLines="4"
                            android:gravity="top"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/wellness_bg"
        android:paddingStart="16dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="Cancelar"
            android:textColor="@color/blue_primary"
            android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalvar"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:text="Salvar meu registro"
            android:textSize="15sp"
            android:textColor="@color/white"
            app:cornerRadius="24dp" />
    </LinearLayout>
</LinearLayout>
