<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@drawable/bg_flo_gradient">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <ImageButton
                android:id="@+id/btnHeaderVoltar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_white_round"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/blue_primary"
                android:contentDescription="Voltar" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:id="@+id/tvTituloHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seu cuidado começa aqui"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tvEtapaIndicador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Boas-vindas"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/pbWizard"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginBottom="26dp"
            android:max="4"
            android:progressDrawable="@drawable/custom_progress_bar"
            android:visibility="gone" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/layoutPerfilResumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SEU CUIDADO, DO SEU JEITO"
                    android:textSize="10sp"
                    android:textColor="@color/blue_primary"
                    android:lineSpacingExtra="3dp"
                    android:letterSpacing="0.13"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Um plano para o seu dia."
                    android:textSize="30sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.035"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aqui estão suas informações e sua meta estimada. Você pode ajustar tudo quando precisar."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="24dp" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <com.example.hidratapp.WaterIllustrationView
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sua meta diária estimada"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:lineSpacingExtra="3dp"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/tvResumoMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="32sp"
                            android:gravity="center"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/blue_primary"
                            android:layout_marginTop="8dp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pequenos registros. Um hábito de cada vez."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:lineSpacingExtra="3dp"
                            android:gravity="center"
                            android:layout_marginTop="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sobre você"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="12dp" />
                        <TextView
                            android:id="@+id/tvResumoPesoAltura"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="10dp" />
                        <TextView
                            android:id="@+id/tvResumoIdadeSexo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="10dp" />
                        <TextView
                            android:id="@+id/tvResumoEsporte"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="10dp" />
                        <TextView
                            android:id="@+id/tvResumoIMC"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cuidados registrados"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="12dp" />
                        <TextView
                            android:id="@+id/tvResumoSaude"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConcluirPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="Ir para meu dia"
                    android:textColor="@color/white"
                    app:cornerRadius="24dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditarPerfil"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="Editar meu perfil"
                    android:textColor="@color/blue_primary"
                    app:cornerRadius="24dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutStep0Welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">
                <com.example.hidratapp.WaterIllustrationView
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BEM-VINDO AO SEU NOVO HÁBITO"
                    android:textSize="10sp"
                    android:textColor="@color/blue_primary"
                    android:lineSpacingExtra="3dp"
                    android:letterSpacing="0.13"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seu bem-estar começa com um gole."
                    android:textSize="30sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.035"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Um espaço simples para acompanhar sua hidratação e cuidar de você, no seu ritmo."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="24dp" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_target"
                                app:tint="@color/blue_primary"
                                android:importantForAccessibility="no" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="14dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Uma meta feita para você"
                                    android:textSize="15sp"
                                    android:textColor="@color/text_primary"
                                    android:lineSpacingExtra="3dp"
                                    android:fontFamily="sans-serif-medium" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Uma estimativa baseada no seu perfil."
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"
                                    android:lineSpacingExtra="3dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_chart_bar"
                                app:tint="@color/blue_primary"
                                android:importantForAccessibility="no" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="14dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Seu progresso, bem de perto"
                                    android:textSize="15sp"
                                    android:textColor="@color/text_primary"
                                    android:lineSpacingExtra="3dp"
                                    android:fontFamily="sans-serif-medium" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Cada registro ajuda a enxergar sua rotina."
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"
                                    android:lineSpacingExtra="3dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIniciarCadastro"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="Vamos começar"
                    android:textColor="@color/white"
                    app:cornerRadius="24dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sem criar conta. Seus registros ficam no aparelho."
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutStep1Genero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_soft_blue"
                    android:src="@drawable/ic_person"
                    app:tint="@color/blue_primary"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="UM PERFIL QUE É SEU"
                    android:textSize="10sp"
                    android:textColor="@color/blue_primary"
                    android:lineSpacingExtra="3dp"
                    android:letterSpacing="0.13"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vamos começar pelo básico."
                    android:textSize="30sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.035"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selecione a informação usada na estimativa da sua meta diária."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="24dp" />
                <RadioGroup
                    android:id="@+id/rgSexo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <RadioButton
                        android:id="@+id/rbFeminino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_choice"
                        android:padding="16dp"
                        android:text="Feminino"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/blue_primary"
                        android:checked="false" />
                    <RadioButton
                        android:id="@+id/rbMasculino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_choice"
                        android:padding="16dp"
                        android:text="Masculino"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/blue_primary"
                        android:checked="false" />
                </RadioGroup>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Você pode editar seu perfil quando quiser."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep1Proximo"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="Continuar"
                    android:textColor="@color/white"
                    app:cornerRadius="24dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutStep2Fisico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_soft_blue"
                    android:src="@drawable/ic_scale"
                    app:tint="@color/blue_primary"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CADA PESSOA TEM SEU RITMO"
                    android:textSize="10sp"
                    android:textColor="@color/blue_primary"
                    android:lineSpacingExtra="3dp"
                    android:letterSpacing="0.13"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Um pouco sobre você."
                    android:textSize="30sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.035"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Essas medidas ajudam a estimar uma meta para acompanhar seu dia."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="24dp" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="Seu peso"
                            app:suffixText="kg"
                            app:boxCornerRadiusTopStart="18dp"
                            app:boxCornerRadiusTopEnd="18dp"
                            app:boxCornerRadiusBottomStart="18dp"
                            app:boxCornerRadiusBottomEnd="18dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPeso"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="60dp"
                                android:inputType="numberDecimal"
                                android:textColor="@color/text_primary"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="Sua altura"
                            app:suffixText="cm"
                            app:boxCornerRadiusTopStart="18dp"
                            app:boxCornerRadiusTopEnd="18dp"
                            app:boxCornerRadiusBottomStart="18dp"
                            app:boxCornerRadiusBottomEnd="18dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAltura"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="60dp"
                                android:inputType="number"
                                android:textColor="@color/text_primary"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="Sua idade"
                            app:suffixText="anos"
                            app:boxCornerRadiusTopStart="18dp"
                            app:boxCornerRadiusTopEnd="18dp"
                            app:boxCornerRadiusBottomStart="18dp"
                            app:boxCornerRadiusBottomEnd="18dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etIdade"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="60dp"
                                android:inputType="number"
                                android:textColor="@color/text_primary"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep2Proximo"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="Continuar"
                    android:textColor="@color/white"
                    app:cornerRadius="24dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep2Voltar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="Voltar"
                    android:textColor="@color/blue_primary"
                    app:cornerRadius="24dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutStep3Esporte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_soft_mint"
                    android:src="@drawable/ic_fitness"
                    app:tint="@color/blue_primary"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="O MOVIMENTO NA SUA ROTINA"
                    android:textSize="10sp"
                    android:textColor="@color/blue_primary"
                    android:lineSpacingExtra="3dp"
                    android:letterSpacing="0.13"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Como é o seu ritmo?"
                    android:textSize="30sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.035"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Escolha a opção que mais combina com sua semana."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="24dp" />
                <RadioGroup
                    android:id="@+id/rgEsporte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <RadioButton
                        android:id="@+id/rbEsporteSedentario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_choice"
                        android:padding="16dp"
                        android:text="No meu ritmo&#10;Pouca atividade física"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/blue_primary"
                        android:checked="true" />
                    <RadioButton
                        android:id="@+id/rbEsporteLeve"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_choice"
                        android:padding="16dp"
                        android:text="Leve&#10;1 a 2 vezes por semana"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/blue_primary"
                        android:checked="false" />
                    <RadioButton
                        android:id="@+id/rbEsporteModerado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_choice"
                        android:padding="16dp"
                        android:text="Moderado&#10;3 a 4 vezes por semana"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/blue_primary"
                        android:checked="false" />
                    <RadioButton
                        android:id="@+id/rbEsporteIntenso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_choice"
                        android:padding="16dp"
                        android:text="Intenso&#10;5 ou mais vezes por semana"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/blue_primary"
                        android:checked="false" />
                </RadioGroup>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep3Proximo"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="Continuar"
                    android:textColor="@color/white"
                    app:cornerRadius="24dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep3Voltar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="Voltar"
                    android:textColor="@color/blue_primary"
                    app:cornerRadius="24dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutStep4Saude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_soft_mint"
                    android:src="@drawable/ic_heart_health"
                    app:tint="@color/blue_primary"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="UM OLHAR PARA O SEU CUIDADO"
                    android:textSize="10sp"
                    android:textColor="@color/blue_primary"
                    android:lineSpacingExtra="3dp"
                    android:letterSpacing="0.13"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Algum cuidado especial?"
                    android:textSize="30sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.035"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Esta etapa é opcional. Marque apenas o que fizer sentido para você."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="24dp" />
                <CheckBox
                    android:id="@+id/cbDiabetes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_choice"
                    android:padding="14dp"
                    android:buttonTint="@color/blue_primary"
                    android:text="Diabetes"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <CheckBox
                    android:id="@+id/cbHipertensao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_choice"
                    android:padding="14dp"
                    android:buttonTint="@color/blue_primary"
                    android:text="Hipertensão"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <CheckBox
                    android:id="@+id/cbAlcoolismo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_choice"
                    android:padding="14dp"
                    android:buttonTint="@color/blue_primary"
                    android:text="Histórico de problemas com álcool"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <CheckBox
                    android:id="@+id/cbPedrasRins"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_choice"
                    android:padding="14dp"
                    android:buttonTint="@color/blue_primary"
                    android:text="Histórico de cálculos renais"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Seu cuidado vem primeiro"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="6dp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="A meta é uma estimativa do projeto. Respeite orientações profissionais e eventuais restrições de líquidos."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSalvarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="Criar minha meta"
                    android:textColor="@color/white"
                    app:cornerRadius="24dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep4Voltar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="Voltar"
                    android:textColor="@color/blue_primary"
                    app:cornerRadius="24dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</ScrollView>
