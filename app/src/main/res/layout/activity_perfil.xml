<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@drawable/bg_flo_gradient">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <ImageButton
                android:id="@+id/btnHeaderVoltar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_white_round"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/blue_primary"
                android:contentDescription="@string/cadastro_bebida_voltar" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:id="@+id/tvTituloHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_seu_cuidado_comeca_aqui"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/tvEtapaIndicador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_boas_vindas"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/pbWizard"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginBottom="26dp"
            android:max="4"
            android:progressDrawable="@drawable/custom_progress_bar"
            android:visibility="gone" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/layoutPerfilResumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_seu_cuidado_do_seu_jeito"
                    android:textSize="10sp"
                    android:textColor="@color/blue_primary"
                    android:lineSpacingExtra="3dp"
                    android:letterSpacing="0.13"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_um_plano_para_o_seu_dia"
                    android:textSize="30sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.035"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_aqui_estao_suas_informacoes_e_sua_meta"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="24dp" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <com.example.hidratapp.WaterIllustrationView
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/perfil_sua_meta_diaria_estimada"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:lineSpacingExtra="3dp"
                            android:gravity="center" />
                        <TextView
                            android:id="@+id/tvResumoMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="32sp"
                            android:gravity="center"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/blue_primary"
                            android:layout_marginTop="8dp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/perfil_pequenos_registros_um_habito_de_cada_vez"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:lineSpacingExtra="3dp"
                            android:gravity="center"
                            android:layout_marginTop="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/perfil_sobre_voce"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="12dp" />
                        <TextView
                            android:id="@+id/tvResumoPesoAltura"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="10dp" />
                        <TextView
                            android:id="@+id/tvResumoIdadeSexo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="10dp" />
                        <TextView
                            android:id="@+id/tvResumoEsporte"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="10dp" />
                        <TextView
                            android:id="@+id/tvResumoIMC"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/perfil_cuidados_registrados"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="12dp" />
                        <TextView
                            android:id="@+id/tvResumoSaude"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:layout_marginBottom="10dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConcluirPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/perfil_ir_para_meu_dia"
                    android:textColor="@color/white"
                    app:cornerRadius="24dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditarPerfil"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/perfil_editar_meu_perfil"
                    android:textColor="@color/blue_primary"
                    app:cornerRadius="24dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutStep0Welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">
                <com.example.hidratapp.WaterIllustrationView
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_bem_vindo_ao_seu_novo_habito"
                    android:textSize="10sp"
                    android:textColor="@color/blue_primary"
                    android:lineSpacingExtra="3dp"
                    android:letterSpacing="0.13"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_seu_bem_estar_comeca_com_um_gole"
                    android:textSize="30sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.035"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_um_espaco_simples_para_acompanhar_sua_hidratacao"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="24dp" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_target"
                                app:tint="@color/blue_primary"
                                android:importantForAccessibility="no" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="14dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/perfil_uma_meta_feita_para_voce"
                                    android:textSize="15sp"
                                    android:textColor="@color/text_primary"
                                    android:lineSpacingExtra="3dp"
                                    android:fontFamily="sans-serif-medium" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/perfil_uma_estimativa_baseada_no_seu_perfil"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"
                                    android:lineSpacingExtra="3dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_chart_bar"
                                app:tint="@color/blue_primary"
                                android:importantForAccessibility="no" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginStart="14dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/perfil_seu_progresso_bem_de_perto"
                                    android:textSize="15sp"
                                    android:textColor="@color/text_primary"
                                    android:lineSpacingExtra="3dp"
                                    android:fontFamily="sans-serif-medium" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/perfil_cada_registro_ajuda_a_enxergar_sua_rotina"
                                    android:textSize="12sp"
                                    android:textColor="@color/text_secondary"
                                    android:lineSpacingExtra="3dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIniciarCadastro"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/perfil_vamos_comecar"
                    android:textColor="@color/white"
                    app:cornerRadius="24dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_sem_criar_conta_seus_registros_ficam_no"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutStep1Genero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_soft_blue"
                    android:src="@drawable/ic_person"
                    app:tint="@color/blue_primary"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_um_perfil_que_e_seu"
                    android:textSize="10sp"
                    android:textColor="@color/blue_primary"
                    android:lineSpacingExtra="3dp"
                    android:letterSpacing="0.13"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_vamos_comecar_pelo_basico"
                    android:textSize="30sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.035"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_selecione_a_informacao_usada_na_estimativa_da"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="24dp" />
                <RadioGroup
                    android:id="@+id/rgSexo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <RadioButton
                        android:id="@+id/rbFeminino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_choice"
                        android:padding="16dp"
                        android:text="@string/perfil_feminino"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/blue_primary"
                        android:checked="false" />
                    <RadioButton
                        android:id="@+id/rbMasculino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_choice"
                        android:padding="16dp"
                        android:text="@string/perfil_masculino"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/blue_primary"
                        android:checked="false" />
                </RadioGroup>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_voce_pode_editar_seu_perfil_quando_quiser"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep1Proximo"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/perfil_continuar"
                    android:textColor="@color/white"
                    app:cornerRadius="24dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutStep2Fisico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_soft_blue"
                    android:src="@drawable/ic_scale"
                    app:tint="@color/blue_primary"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_cada_pessoa_tem_seu_ritmo"
                    android:textSize="10sp"
                    android:textColor="@color/blue_primary"
                    android:lineSpacingExtra="3dp"
                    android:letterSpacing="0.13"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_um_pouco_sobre_voce"
                    android:textSize="30sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.035"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_essas_medidas_ajudam_a_estimar_uma_meta"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="24dp" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="@string/perfil_seu_peso"
                            app:suffixText="kg"
                            app:boxCornerRadiusTopStart="18dp"
                            app:boxCornerRadiusTopEnd="18dp"
                            app:boxCornerRadiusBottomStart="18dp"
                            app:boxCornerRadiusBottomEnd="18dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPeso"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="60dp"
                                android:inputType="numberDecimal"
                                android:textColor="@color/text_primary"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="@string/perfil_sua_altura"
                            app:suffixText="cm"
                            app:boxCornerRadiusTopStart="18dp"
                            app:boxCornerRadiusTopEnd="18dp"
                            app:boxCornerRadiusBottomStart="18dp"
                            app:boxCornerRadiusBottomEnd="18dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAltura"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="60dp"
                                android:inputType="number"
                                android:textColor="@color/text_primary"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:hint="@string/perfil_sua_idade"
                            app:suffixText="anos"
                            app:boxCornerRadiusTopStart="18dp"
                            app:boxCornerRadiusTopEnd="18dp"
                            app:boxCornerRadiusBottomStart="18dp"
                            app:boxCornerRadiusBottomEnd="18dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etIdade"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="60dp"
                                android:inputType="number"
                                android:textColor="@color/text_primary"
                                android:imeOptions="actionNext" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep2Proximo"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/perfil_continuar"
                    android:textColor="@color/white"
                    app:cornerRadius="24dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep2Voltar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/cadastro_bebida_voltar"
                    android:textColor="@color/blue_primary"
                    app:cornerRadius="24dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutStep3Esporte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_soft_mint"
                    android:src="@drawable/ic_fitness"
                    app:tint="@color/blue_primary"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_o_movimento_na_sua_rotina"
                    android:textSize="10sp"
                    android:textColor="@color/blue_primary"
                    android:lineSpacingExtra="3dp"
                    android:letterSpacing="0.13"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_como_e_o_seu_ritmo"
                    android:textSize="30sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.035"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_escolha_a_opcao_que_mais_combina_com"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="24dp" />
                <RadioGroup
                    android:id="@+id/rgEsporte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <RadioButton
                        android:id="@+id/rbEsporteSedentario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_choice"
                        android:padding="16dp"
                        android:text="@string/perfil_no_meu_ritmo_pouca_atividade_fisica"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/blue_primary"
                        android:checked="true" />
                    <RadioButton
                        android:id="@+id/rbEsporteLeve"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_choice"
                        android:padding="16dp"
                        android:text="@string/perfil_leve_1_a_2_vezes_por_semana"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/blue_primary"
                        android:checked="false" />
                    <RadioButton
                        android:id="@+id/rbEsporteModerado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_choice"
                        android:padding="16dp"
                        android:text="@string/perfil_moderado_3_a_4_vezes_por_semana"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/blue_primary"
                        android:checked="false" />
                    <RadioButton
                        android:id="@+id/rbEsporteIntenso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_choice"
                        android:padding="16dp"
                        android:text="@string/perfil_intenso_5_ou_mais_vezes_por_semana"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/blue_primary"
                        android:checked="false" />
                </RadioGroup>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep3Proximo"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/perfil_continuar"
                    android:textColor="@color/white"
                    app:cornerRadius="24dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep3Voltar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/cadastro_bebida_voltar"
                    android:textColor="@color/blue_primary"
                    app:cornerRadius="24dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layoutStep4Saude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="15dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_soft_mint"
                    android:src="@drawable/ic_heart_health"
                    app:tint="@color/blue_primary"
                    android:importantForAccessibility="no" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_um_olhar_para_o_seu_cuidado"
                    android:textSize="10sp"
                    android:textColor="@color/blue_primary"
                    android:lineSpacingExtra="3dp"
                    android:letterSpacing="0.13"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_algum_cuidado_especial"
                    android:textSize="30sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.035"
                    android:layout_marginBottom="10dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/perfil_esta_etapa_e_opcional_marque_apenas_o"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="24dp" />
                <CheckBox
                    android:id="@+id/cbDiabetes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_choice"
                    android:padding="14dp"
                    android:buttonTint="@color/blue_primary"
                    android:text="@string/perfil_diabetes"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <CheckBox
                    android:id="@+id/cbHipertensao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_choice"
                    android:padding="14dp"
                    android:buttonTint="@color/blue_primary"
                    android:text="@string/perfil_hipertensao"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <CheckBox
                    android:id="@+id/cbAlcoolismo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_choice"
                    android:padding="14dp"
                    android:buttonTint="@color/blue_primary"
                    android:text="@string/perfil_historico_de_problemas_com_alcool"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <CheckBox
                    android:id="@+id/cbPedrasRins"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_choice"
                    android:padding="14dp"
                    android:buttonTint="@color/blue_primary"
                    android:text="@string/perfil_historico_de_calculos_renais"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/perfil_seu_cuidado_vem_primeiro"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary"
                            android:lineSpacingExtra="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="6dp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/perfil_a_meta_e_uma_estimativa_do_projeto"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSalvarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/perfil_criar_minha_meta"
                    android:textColor="@color/white"
                    app:cornerRadius="24dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStep4Voltar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/cadastro_bebida_voltar"
                    android:textColor="@color/blue_primary"
                    app:cornerRadius="24dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</ScrollView>
